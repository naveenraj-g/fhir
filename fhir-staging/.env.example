# True per-environment secrets only. Everything else — logging, which routers
# are mounted — is checked-in application behavior and lives in
# configs/config.yaml instead.
#
# Any nested config field can still be overridden by a real env var using __
# as the nesting delimiter, e.g. LOGGING__LEVEL=DEBUG or LOGGING__SQL_ECHO=true.

ENVIRONMENT=production

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below.
# "db" is the Docker service name — do not change the hostname.
STAGING_DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@db/fhir-staging

POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=fhir-staging

# Host port the db is published on (docker-compose.prod.yml) — deliberately
# exposed so external tools like Airflow can connect directly.
# e.g. postgresql://postgres:yourpassword@<host>:5489/fhir-staging
POSTGRES_PORT=5489
